{
  "manifest_version": 3,
  "name": "Open Diff Checker",
  "version": "3.1",
  "description": "Fast, privacy-first, open-source diff checker that runs entirely offline. Your text never leaves the browser.",
  "action": {
    "default_title": "Open Diff Checker",
    "default_icon": {
      "16": "src/images/icon-16.png",
      "32": "src/images/icon-32.png",
      "48": "src/images/icon-48.png",
      "128": "src/images/icon-128.png"
    }
  },
  "icons": {
    "16": "src/images/icon-16.png",
    "32": "src/images/icon-32.png",
    "48": "src/images/icon-48.png",
    "128": "src/images/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "offline_enabled": true,
  "permissions": []
}
